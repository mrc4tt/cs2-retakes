<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DebugType>portable</DebugType>
    <UseCounterStrikeSharp>true</UseCounterStrikeSharp>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RetakesPluginShared\RetakesPluginShared.csproj"><Private>false</Private></ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="lang\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="map_config\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="..\CounterStrikeSharp.targets" />
</Project>
